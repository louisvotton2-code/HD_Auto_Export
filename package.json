{
  "name": "hd-auto-export",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @hd/web dev",
    "build": "pnpm --filter @hd/web build",
    "preview": "pnpm --filter @hd/web preview",
    "typecheck": "pnpm --filter @hd/web typecheck",
    "test": "pnpm --filter @hd/web test",
    "test:watch": "pnpm --filter @hd/web test:watch",
    "test:e2e": "pnpm --filter @hd/web test:e2e",
    "check": "pnpm check:workspace && pnpm --filter @hd/web check",
    "check:workspace": "node --test scripts/check-workspace.test.mjs && node scripts/check-workspace.mjs",
    "check:boundaries": "pnpm check:workspace && pnpm --filter @hd/web check:boundaries"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
