# Keep empty for local development; configure the real public origin before release.
# Example: https://auto.example.com (origin only, no path). Rebuild after changes.
NEXT_PUBLIC_SITE_URL=
# Preview is intentionally not indexed. Set to true only after production review.
# This affects build output including robots/sitemap; rebuild after changes.
SITE_INDEXABLE=false

# Server-only API origin; never use a NEXT_PUBLIC prefix or add credentials.
VEHICLE_API_BASE_URL=http://127.0.0.1:3320

# Server-only; default false. Enable ONLY with private web ingress and a gateway that
# overwrites X-HD-Visitor-IP from $remote_addr. API must trust only the fixed web /32.
# Never trust browser-supplied X-Forwarded-For or expose the web service port publicly.
VEHICLE_API_TRUST_PROXY_IP=false
