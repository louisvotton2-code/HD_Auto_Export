NODE_ENV=development
HOST=127.0.0.1
PORT=3320
DATABASE_URL=postgresql://hd_local:local-development-only@127.0.0.1:55432/hd_auto
# Generate your own random value of at least 32 characters. Never commit a real secret.
AUTH_SECRET=replace-with-a-random-local-secret-before-starting
AUTH_BASE_URL=http://127.0.0.1:3318
TRUSTED_ORIGINS=http://127.0.0.1:3318
MEDIA_ROOT=.data/media
# direct sends bytes in native development. nginx requires the protected internal
# /_hd_media/ location and a read-only media mount under the same service UID.
# Never enable nginx when clients can bypass that configured Nginx ingress.
MEDIA_DELIVERY=direct
DB_POOL_MAX=5
# Keep false for direct requests. For a controlled Compose proxy, use its fixed IP,
# e.g. 172.29.0.2/32 (example only; match the actual network). Comma-separated IPs
# or bounded CIDRs are supported: IPv4 /24-/32, IPv6 /64-/128; prefer /32 or /128.
# Do not expose the API port to the host; the proxy must overwrite X-Forwarded-*.
TRUST_PROXY=false
# Synthetic external catalog is available only on loopback with an isolated hd_ext_* database.
EXTERNAL_CATALOG_MODE=disabled
# Explicit provider selection only; disabled until account/service details are verified.
TRANSLATION_PROVIDER=disabled
# LIBRETRANSLATE_URL=http://127.0.0.1:3340
# Set the actual pinned service/model/config version; rotate after model changes.
# LIBRETRANSLATE_ENGINE_VERSION=verified-local-model-config-1
# LIBRETRANSLATE_API_KEY=
# Aliyun Universal Edition: explicitly select TRANSLATION_PROVIDER=aliyun.
# ALI_MT_ACCESS_KEY_ID=
# ALI_MT_ACCESS_KEY_SECRET=
# ALI_MT_SECURITY_TOKEN=
# Fixed endpoints only: cn-hangzhou (China site compatibility default),
# ap-southeast-1 (Singapore, chosen for this account's international-site service).
# Never assume China-site free quotas/pricing apply to the international account.
ALI_MT_REGION=cn-hangzhou
ALI_MT_CONFIG_VERSION=1
# Local per-process hourly resource/call budget, charged for each target language.
TRANSLATION_MAX_CHARACTERS_PER_HOUR=50000
