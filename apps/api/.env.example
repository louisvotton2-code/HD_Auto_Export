NODE_ENV=development
HOST=127.0.0.1
PORT=3320
DATABASE_URL=postgresql://hd_local:local-development-only@127.0.0.1:55432/hd_auto
# Generate your own random value of at least 32 characters. Never commit a real secret.
AUTH_SECRET=replace-with-a-random-local-secret-before-starting
AUTH_BASE_URL=http://127.0.0.1:3318
TRUSTED_ORIGINS=http://127.0.0.1:3318
MEDIA_ROOT=.data/media
# direct sends bytes in native development. nginx requires the protected internal
# /_hd_media/ location and a read-only media mount under the same service UID.
# Never enable nginx when clients can bypass that configured Nginx ingress.
MEDIA_DELIVERY=direct
DB_POOL_MAX=5
# Keep false for direct requests. For a controlled Compose proxy, use its fixed IP,
# e.g. 172.29.0.2/32 (example only; match the actual network). Comma-separated IPs
# or bounded CIDRs are supported: IPv4 /24-/32, IPv6 /64-/128; prefer /32 or /128.
# Do not expose the API port to the host; the proxy must overwrite X-Forwarded-*.
TRUST_PROXY=false
