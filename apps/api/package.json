{
  "name": "@hd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HD Auto independent inventory API",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "test:integration": "node --import tsx --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "staff": "node --env-file-if-exists=.env --import tsx src/staff-cli.ts",
    "media:cleanup": "node --env-file-if-exists=.env --import tsx src/cleanup.ts",
    "external:sample": "node --import tsx src/external/sample-cli.ts",
    "openapi": "node --import tsx src/openapi.ts"
  },
  "dependencies": {
    "@hd/contracts": "workspace:*",
    "@better-auth/drizzle-adapter": "1.7.18",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
