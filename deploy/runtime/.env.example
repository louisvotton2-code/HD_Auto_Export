# Absolute data location outside build output. Actual env stays ignored.
DATA_ROOT=/srv/hd-auto/data
RELEASE_ID=replace-with-reviewed-source-id
SITE_ORIGIN=https://localhost:3410
SITE_INDEXABLE=false
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=3410
# This machine: linux/arm64. New x86 server: build and test linux/amd64.
TARGET_PLATFORM=linux/arm64
# Owner of media and secrets; use id -u / id -g on the local host.
APP_UID=1000
APP_GID=1000

# Optional compose.proxy.yaml: choose a free subnet and reserve the low half.
# PROXY_SUBNET=172.30.80.0/24
# PROXY_DYNAMIC_RANGE=172.30.80.128/25
# PROXY_GATEWAY=172.30.80.1
# PROXY_IP=172.30.80.2
# WEB_IP=172.30.80.3
