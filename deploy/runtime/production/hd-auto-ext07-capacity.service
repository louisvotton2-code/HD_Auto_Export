[Unit]
Description=HD Auto measured capacity decision
RequiresMountsFor=/srv/hd-auto/data /srv/hd-auto/staging /srv/hd-auto/secrets

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /srv/hd-auto/staging/ext07/current-source/deploy/runtime/production/capacity-decision.py
User=root
UMask=0027
CPUQuota=25%
MemoryMax=512M
TasksMax=32
TimeoutStartSec=55
