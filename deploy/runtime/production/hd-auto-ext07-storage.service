[Unit]
Description=HD Auto production disk threshold alert
RequiresMountsFor=/srv/hd-auto/data /srv/hd-auto/staging /srv/hd-auto/secrets

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /srv/hd-auto/staging/ext07/current-source/deploy/runtime/production/storage-alert.py --config /etc/hd-auto/capacity.json
ExecStartPost=/usr/bin/python3 /srv/hd-auto/staging/ext07/current-source/deploy/runtime/production/storage-alert.py --system-disk
User=root
UMask=0077
CPUQuota=5%
MemoryMax=64M
TasksMax=16
TimeoutStartSec=30
