[Unit]
Description=HD Auto closed-hour page document import
Wants=docker.service
After=docker.service
RequiresMountsFor=/srv/hd-auto/data /srv/hd-auto/staging /srv/hd-auto/secrets
ConditionPathExists=/srv/hd-auto/secrets/v2/page-documents.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /srv/hd-auto/staging/v2/current-source/deploy/runtime/production/collect-page-documents.py --config /srv/hd-auto/secrets/v2/page-documents.json
User=root
UMask=0077
CPUQuota=25%
MemoryMax=384M
TasksMax=32
TimeoutStartSec=4min
Restart=on-failure
RestartSec=5min
