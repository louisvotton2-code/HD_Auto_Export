[Unit]
Description=HD Auto bounded compressed capacity probe
RequiresMountsFor=/srv/hd-auto/data /srv/hd-auto/staging

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /srv/hd-auto/staging/ext07/current-source/deploy/runtime/production/capacity-measure.py --probe
User=root
UMask=0077
CPUQuota=25%
MemoryMax=512M
TasksMax=32
TimeoutStartSec=1250
