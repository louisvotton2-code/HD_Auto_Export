{
  "name": "@hd/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-safe vehicle API schemas, inferred types and isolated fixtures.",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./public": { "types": "./dist/public.d.ts", "import": "./dist/public.js" },
    "./admin": { "types": "./dist/admin.d.ts", "import": "./dist/admin.js" },
    "./fixtures": { "types": "./dist/fixtures.d.ts", "import": "./dist/fixtures.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": { "typescript": "5.9.3" }
}
